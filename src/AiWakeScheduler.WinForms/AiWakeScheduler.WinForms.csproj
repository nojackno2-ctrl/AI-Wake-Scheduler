<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AI倒數喚醒</AssemblyName>
    <RootNamespace>AiWakeScheduler.WinForms</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <!-- 每個螢幕各自的 DPI 都會正確套用，多螢幕混合縮放時文字不會糊掉 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 常駐系統匣的桌面程式：工作站 GC 且不使用背景 GC 執行緒，
         閒置時記憶體與 CPU 都比預設低 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- WinForms trimming is unsupported for this application.  Keep only the
         two UI languages in self-contained publish output instead. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>zh-Hant;en</SatelliteResourceLanguages>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Product>AI 倒數喚醒</Product>
    <Company>AI Wake Scheduler</Company>
    <Authors>AI Wake Scheduler</Authors>
    <Description>每日定時平行喚醒 Antigravity、Claude 與 OpenAI Codex CLI 之 Windows 桌面工具</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiWakeScheduler.Core\AiWakeScheduler.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\app.ico" Link="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
